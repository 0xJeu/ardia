---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Showcase from "../components/Showcase.astro";
import Features from "../components/Features.astro";
import Engine from "../components/Engine.astro";
import Game from "../components/Game.astro";
import Faq from "../components/Faq.astro";
import Closing from "../components/Closing.astro";
import Footer from "../components/Footer.astro";
import { DMG, DMG_SIZE, MIN_MACOS, REPO, VERSION } from "../data/release";

const home = new URL(import.meta.env.BASE_URL, Astro.site).href;
const description =
  "A Mac browser with Arc's sidebar and Dia's polish, built on real Chromium. Open source, notarized by Apple, and no account to make.";
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Arcadia",
    description,
    url: home,
    image: new URL("og.png", home).href,
    applicationCategory: "BrowserApplication",
    operatingSystem: `${MIN_MACOS} or later, Apple Silicon`,
    softwareVersion: VERSION,
    downloadUrl: DMG,
    fileSize: DMG_SIZE,
    releaseNotes: new URL("release-notes/", home).href,
    license: "https://www.apache.org/licenses/LICENSE-2.0",
    sameAs: [REPO],
  },
  { "@context": "https://schema.org", "@type": "WebSite", name: "Arcadia", url: home },
];
---

<Base
  title="Arcadia · the sidebar browser for Mac, on real Chromium"
  description={description}
  jsonLd={jsonLd}
>
  <Header />
  <main>
    <Hero />
    <Showcase />
    <Features />
    <Engine />
    <Game />
    <Faq />
    <Closing />
  </main>
  <Footer />
</Base>

<script>
  import "../scripts/motion";
  import "../scripts/tilt";
</script>
