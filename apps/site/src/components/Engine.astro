---
// What's under it, as a checklist: what's in (ticked), what's partly in (a dash), what isn't yet (empty box).
type Status = "yes" | "part" | "no";
const rows: { item: string; detail: string; status: Status; label?: string }[] = [
  { item: "Engine", detail: "Chromium 154. Chrome’s own framework.", status: "yes" },
  { item: "Windows", detail: "Chrome’s own. Menus and autofill just work.", status: "yes" },
  { item: "De-Googled", detail: "ungoogled-chromium underneath.", status: "yes" },
  { item: "H.264 and AAC", detail: "The codecs Chromium leaves out.", status: "yes" },
  { item: "DevTools", detail: "Docked, with device mode. Like Chrome.", status: "yes" },
  { item: "Notarized", detail: "Scanned by Apple. Opens without a warning.", status: "yes" },
  { item: "Passkeys", detail: "Touch ID yes. iCloud Keychain waits on Apple.", status: "part" },
  { item: "Sync", detail: "End to end encrypted. No account, no server.", status: "yes" },
  { item: "Translate", detail: "On your Mac. Nothing leaves it.", status: "yes", label: "Yes, macOS 26" },
  { item: "Widevine", detail: "So no Netflix.", status: "no" },
  { item: "Intel Macs", detail: "Apple Silicon only.", status: "no", label: "No" },
];
const labels: Record<Status, string> = { yes: "Yes", part: "Partly", no: "Not yet" };
---

{/* data-shot="record" stays: it names this section in the section_viewed analytics. */}
<section class="engine" id="chromium" aria-labelledby="engine-title" data-shot="record">
  <div class="wrap engine-grid">
    <header class="engine-head">
      <p class="label kicker">The engine</p>
      <h2 class="poster" id="engine-title" data-reveal>It’s actually Chromium.</h2>
      <p class="lede" data-reveal style="--i: 1">Not WebKit. Not Electron. Every window is Chrome’s own.</p>
    </header>

    <div class="checklist" role="table" aria-label="What Ardia does and doesn’t do yet">
      <div class="checklist-top label" role="row">
        <span role="columnheader">Part</span>
        <span role="columnheader">Details</span>
        <span role="columnheader">Status</span>
      </div>
      {
        rows.map((r) => (
          <div class:list={["row", r.status]} role="row">
            <span class="item" role="cell">{r.item}</span>
            <span class="detail" role="cell">{r.detail}</span>
            <span class="status label" role="cell">
              <span class="box" aria-hidden="true">
                {r.status !== "no" && (
                  <svg viewBox="0 0 20 20" width="20" height="20">
                    <path d={r.status === "yes" ? "M3.5 10.5l4.2 4.3L16.8 4" : "M4 10h12"} fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="square" />
                  </svg>
                )}
              </span>
              {r.label ?? labels[r.status]}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .engine {
    margin-top: var(--section);
    background: var(--night);
    color: var(--night-ink);
    padding: var(--section) 0;
  }
  .engine ::selection {
    background: var(--night-ink);
    color: var(--night);
  }
  .engine-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: clamp(48px, 7vw, 96px);
  }
  .engine-head {
    grid-column: 1 / span 5;
    align-self: start;
    position: sticky;
    top: 100px;
  }
  .kicker {
    color: var(--night-ink-2);
    margin-bottom: 20px;
  }
  h2 {
    font-size: clamp(2.6rem, 1.2rem + 4vw, 5.6rem);
  }
  .lede {
    margin-top: 28px;
    color: var(--night-ink-2);
    max-width: 28em;
  }
  .checklist {
    grid-column: 7 / -1;
    border-top: 2px solid var(--night-ink);
  }
  .checklist-top {
    display: grid;
    grid-template-columns: 11rem 1fr 7.5rem;
    gap: 16px;
    padding: 10px 0;
    color: var(--night-ink-2);
    border-bottom: 1px solid var(--night-rule);
  }
  .row {
    display: grid;
    grid-template-columns: 11rem 1fr 7.5rem;
    gap: 16px;
    padding: 18px 0;
    border-bottom: 1px solid var(--night-rule);
    align-items: baseline;
  }
  .item {
    font-family: var(--poster);
    font-weight: 720;
    font-stretch: 80%;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    font-size: 1.05rem;
  }
  .detail {
    color: var(--night-ink-2);
    font-size: var(--t-small);
    line-height: 1.45;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    justify-self: start;
    align-self: center;
  }
  .box {
    display: inline-grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border: 1.5px solid var(--night-ink);
    border-radius: 2px;
  }
  .yes .box {
    color: var(--night-ink);
  }
  .part .box {
    color: var(--night-ink-2);
  }
  .no {
    color: color-mix(in srgb, var(--night-ink) 62%, transparent);
  }
  .no .box {
    border-color: var(--night-ink-2);
  }
  .no .status {
    color: #ff8a73;
  }

  @media (max-width: 960px) {
    .engine-head,
    .checklist {
      grid-column: 1 / -1;
      position: static;
    }
  }
  @media (max-width: 600px) {
    .checklist-top {
      display: none;
    }
    .row {
      grid-template-columns: 1fr auto;
      grid-template-areas: "item status" "detail detail";
      row-gap: 6px;
    }
    .item {
      grid-area: item;
    }
    .status {
      grid-area: status;
    }
    .detail {
      grid-area: detail;
    }
  }
</style>
