---
import Shot from "./Shot.astro";
import Plate from "./Plate.astro";
import { duo, features } from "../data/features";
const pad = (n: number) => String(n).padStart(2, "0");
---

<section class="features paint" id="features" aria-label="Features">
  <div class="wrap">
    <ol class="feature-list">
      {
        features.map((p, i) => (
          <li class:list={["feature", p.hour]} id={p.id} data-shot={`pledge-${p.id}`}>
            <div class="feature-text" data-reveal>
              <p class="label kicker num">No. {pad(i + 1)}</p>
              <h3>{p.title}</h3>
              <p class="body">{p.body}</p>
            </div>
            <figure class="feature-figure">
              <Plate hour={p.hour} sun={p.sun} flip={p.flip}>
                <Shot src={p.shots} alt={p.alt} panel={p.panel} loop={p.loop} sizes="(max-width: 900px) 92vw, 52vw" />
              </Plate>
            </figure>
          </li>
        ))
      }
    </ol>

    <ul class="duo">
      {
        duo.map((p, i) => (
          <li class:list={["duo-item", p.hour]} id={p.id} data-shot={`pledge-${p.id}`}>
            <figure class="duo-figure">
              <Plate hour={p.hour} sun={p.sun} flip={p.flip}>
                <Shot src={p.shots} alt={p.alt} sizes="(max-width: 900px) 92vw, 44vw" />
              </Plate>
            </figure>
            <div class="duo-text" data-reveal style={`--i: ${i}`}>
              <p class="label kicker num">No. {pad(features.length + i + 1)}</p>
              <h3>{p.title}</h3>
              <p class="body">{p.body}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .features {
    --bg: var(--morning);
    --wash: linear-gradient(180deg, var(--morning) 0%, var(--morning) 30%, var(--noon) 70%, #f5e3c0 100%);
    padding: clamp(64px, 9vw, 140px) 0 var(--section);
  }

  .feature-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .feature {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    align-items: center;
    padding: clamp(44px, 6vw, 96px) 0;
  }
  .feature:first-child {
    padding-top: 0;
  }
  .feature-text {
    grid-column: 1 / span 4;
    grid-row: 1;
  }
  .feature-figure {
    grid-column: 5 / -1;
    grid-row: 1;
    margin: 0;
  }
  .feature:nth-child(even) .feature-text {
    grid-column: 9 / -1;
  }
  .feature:nth-child(even) .feature-figure {
    grid-column: 1 / span 8;
  }
  .morning .num {
    --dab: var(--sun);
  }
  .noon .num {
    --dab: var(--sage);
  }
  .golden .num {
    --dab: #e98f3c;
  }
  h3 {
    font-weight: 640;
    font-stretch: 110%;
    font-size: var(--t-h3);
    line-height: 1.04;
    letter-spacing: -0.032em;
  }
  .num {
    margin-bottom: 18px;
  }
  .body {
    margin-top: 18px;
    color: var(--ink-2);
    max-width: 26em;
  }

  .duo {
    list-style: none;
    margin: 0;
    padding: clamp(24px, 4vw, 64px) 0 clamp(72px, 9vw, 140px);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(40px, 5vw, 80px) var(--gutter);
    align-items: start;
  }
  .duo-item:nth-child(2) {
    margin-top: clamp(40px, 8vw, 140px);
  }
  .duo-figure {
    margin: 0;
  }
  .duo-text {
    margin-top: 28px;
    max-width: 30em;
  }
  .duo-text h3 {
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2.1rem);
  }
  .duo .num {
    --dab: #e98f3c;
  }

  @media (max-width: 760px) {
    .duo {
      grid-template-columns: 1fr;
    }
    .duo-item:nth-child(2) {
      margin-top: 0;
    }
  }
  @media (max-width: 900px) {
    .feature {
      display: block;
      padding: 48px 0 56px;
    }
    .feature-figure {
      margin-top: 28px;
    }
  }
</style>
