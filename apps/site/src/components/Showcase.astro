---
import Shot from "./Shot.astro";
import DownloadButton from "./DownloadButton.astro";
import Plate from "./Plate.astro";
import windowShot from "../assets/shots/window.webp";
---

<section class="showcase" aria-label="The app" data-shot="office">
  <div class="wrap">
    <figure class="showcase-figure">
      <div class="tilt" data-settle>
        <Plate hour="morning" sun={{ x: 0.84, y: 0.16 }}>
          <Shot
            src={windowShot}
            alt="The Ardia window in light mode: pinned tiles and tabs in the sidebar, and Wikipedia’s article on The Hay Wain, John Constable’s painting of a hay cart crossing a river, open on the right."
            sizes="(max-width: 1440px) 88vw, 1240px"
            focus={{ x: 0, y: 0, zoom: 1.9, ratio: 0.8 }}
          />
        </Plate>
      </div>
    </figure>
    <aside class="band" aria-label="Download" data-download-band hidden>
      <p class="band-line poster">That was a screenshot. <span>This is the app.</span></p>
      <DownloadButton location="office-band" />
    </aside>
  </div>
</section>

<script>
  import { getFeatureFlag } from "../scripts/telemetry";

  const FLAG = "download-band";
  const band = document.querySelector<HTMLElement>("[data-download-band]");
  const show = (variant: unknown) => {
    if (band) band.hidden = variant !== "band";
  };

  if (band && document.documentElement.dataset.device === "mac") {
    const local = /^(localhost|127\.0\.0\.1|\[::1\])$/.test(location.hostname);
    const forced = local ? new URLSearchParams(location.search).get("nnflag") : null;
    if (forced) show(forced);
    else void getFeatureFlag(FLAG).then(show);
  }
</script>

<style>
  .showcase {
    padding-top: clamp(24px, 4vw, 64px);
  }
  .showcase-figure {
    margin: 0;
    perspective: 1600px;
  }
  .tilt {
    transform-origin: 50% 0%;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .tilt {
      transform: rotateX(12deg) scale(0.92) translateY(40px);
      opacity: 0.5;
      transition:
        transform 1300ms var(--ease-out),
        opacity 900ms var(--ease-out);
    }
    :global(.js) .tilt:global(.in) {
      transform: none;
      opacity: 1;
    }
  }
  .band {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px 32px;
    margin-top: clamp(40px, 5vw, 72px);
    padding: 22px 0;
    border-top: 2px solid var(--ink);
    border-bottom: 1px solid var(--rule-strong);
  }
  .band[hidden] {
    display: none;
  }
  .band-line {
    font-size: clamp(2rem, 1.2rem + 2.6vw, 3.6rem);
    line-height: 0.9;
  }
  .band-line span {
    color: var(--accent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .band {
      animation: band-in 600ms var(--ease-out) both;
    }
  }
  @keyframes band-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
  @media (max-width: 640px) {
    .band {
      flex-direction: column;
      align-items: stretch;
    }
    .band :global(.btn) {
      justify-content: center;
    }
  }
</style>
