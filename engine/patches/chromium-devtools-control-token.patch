+void DevToolsHttpHandler::OnArdiaRequest(
+    int connection_id,
+    const net::HttpServerRequestInfo& info) {
+  std::string_view path;
+  std::string_view token;
+  SplitArdiaPath(info.path, &path, &token);
+  std::string target_id;
+  if (!ardia_token_mode_ || info.method != "GET" ||
+      info.headers.count("origin") || path != "/ardia/active" ||
+      !g_ardia_devtools_active_target ||
+      !g_ardia_devtools_active_target(socket_factory_.get(), token,
+                                      &target_id)) {
+    Send404(connection_id);
+    return;
+  }
+  base::DictValue body;
+  if (target_id.empty()) {
+    body.Set("targetId", base::Value());
+  } else {
+    body.Set("targetId", target_id);
+  }
+  SendJson(connection_id, net::HTTP_OK, body, "");
+}
