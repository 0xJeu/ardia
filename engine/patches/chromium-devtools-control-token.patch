+void SplitArdiaPath(std::string_view full,
+                    std::string_view* path,
+                    std::string_view* token) {
+  *path = full;
+  std::string_view query;
+  if (size_t query_pos = full.find('?'); query_pos != std::string_view::npos) {
+    query = full.substr(query_pos + 1);
+    *path = full.substr(0, query_pos);
+  }
+  *token = std::string_view();
+  for (std::string_view pair :
+       base::SplitStringPiece(query, "&", base::KEEP_WHITESPACE,
+                              base::SPLIT_WANT_NONEMPTY)) {
+    if (base::StartsWith(pair, "token=")) {
+      *token = pair.substr(6);
+      return;
+    }
+  }
+}
