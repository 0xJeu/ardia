module ardiacore.mojom;

interface ACRendererConfig {
  SetPageScript(string script);
};

interface ACPageHost {
  Post(string kind, string json);
};

interface ACPage {
  CallPage(string kind, string json);
  Execute(string code);
  Evaluate(string code) => (string? json);
  EnterPictureInPictureForUser() => (bool opened);
  SetPageColor(string color);
};
